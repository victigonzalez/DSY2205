# Copia este archivo como .env (NO se sube a Git) y completa los valores.
# docker compose lo lee automáticamente.

# Contraseña del usuario ADMIN de la base Oracle Autonomous (obligatoria)
DB_PASSWORD=

# Opcionales (estos son los valores por defecto)
DB_SERVICIO=foro_high
DB_USUARIO=ADMIN

# Tu usuario de Docker Hub: se usa para nombrar las imágenes al publicarlas
DOCKERHUB_USUARIO=victigonzalez
